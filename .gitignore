# .gitignore: Prevents sensitive environment variables, and Python cache artifacts from being committed to version control.

# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Local environment settings
.env
.env.*

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Editor / OS files
.DS_Store

.vscode/
query_results.json
query_results.xml
